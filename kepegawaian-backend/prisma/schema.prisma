generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma/client"
}

datasource db {
  provider = "mysql"
  url = env("DATABASE_URL")
}

enum Role {
  Superadmin
  Admin
  Manager
  Karyawan
}

enum JenisKelamin {
  Laki_laki
  Perempuan
}

enum Status {
  Active
  Resigned
  Terminated
}

enum EmploymentType {
  Tetap
  Kontrak
  Internship
}

enum StatusPernikahan {
  Sudah_menikah
  Belum_menikah
  Cerai_mati
}

enum StatusLeaveRequest {
  PENDING
  APPROVED
  REJECTED
}

enum TypeFile {
  KTP
  Ijazah
  Kontrak_kerja
  NPWP
}

model User {
  id Int @id @default(autoincrement())
  username String @db.VarChar(155)
  email String @unique @db.VarChar(155)
  password String  
  role Role
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Departments {
  id Int @id @default(autoincrement())
  code String @db.VarChar(100)
  name String @db.VarChar(155)

  positions Positions[]
  employees Employees[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Positions {
  id Int @id @default(autoincrement())
  title String @db.VarChar(155)
  level String
  departments Departments @relation(fields: [departmentId], references: [id])
  departmentId Int 

  employees Employees[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Employees {
  id               Int            @id @default(autoincrement())
  nip              String         @unique @db.VarChar(155)
  full_name        String         @db.VarChar(155)
  nik              String         @db.VarChar(155)
  jenis_kelamin    JenisKelamin
  birth_place      String         @db.VarChar(155)
  birth_Date       DateTime
  phone            String         @db.VarChar(155)
  address          String         @db.Text
  statusPernikahan StatusPernikahan
  agama            String         @db.VarChar(155)
  join_date        DateTime

  departments   Departments @relation(fields: [departmentId], references: [id])
  departmentId  Int
  position_id   Int
  positions     Positions   @relation(fields: [position_id], references: [id])

  // Relasi
  leave_balances leave_balances[]
  leave_requests leave_requests[] // 👈 Pengajuan cuti pegawai
  employee_document EmployeeDocuments[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Master Jenis Cuti (tidak punya relasi langsung ke Employees)
model leave_types {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(155)
  quota_days  Int

  leave_requests leave_requests[] // 👈 Dipakai di transaksi pengajuan cuti

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Tabel Transaksi Pengajuan Cuti (Menghubungkan Employees & leave_types)
model leave_requests {
  id            Int      @id @default(autoincrement())
  
  employee_id   Int
  employee      Employees @relation(fields: [employee_id], references: [id])

  leave_type_id Int
  leave_type    leave_types @relation(fields: [leave_type_id], references: [id])

  start_date    DateTime
  end_date      DateTime
  reason        String    @db.Text
  status        StatusLeaveRequest @default(PENDING) // PENDING, APPROVED, REJECTED

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model leave_balances {
  id              Int       @id @default(autoincrement())
  
  employee_id     Int
  employee        Employees @relation(fields: [employee_id], references: [id])

  year            Int
  remaining_quota Int

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model EmployeeDocuments {
  id Int @id @default(autoincrement())

  employee_id Int
  employee Employees @relation(fields: [employee_id], references: [id])

  type TypeFile
  file_path String

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}
